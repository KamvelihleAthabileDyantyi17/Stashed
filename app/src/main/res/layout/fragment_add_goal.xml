<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050506">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBarAddGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="22dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnCloseGoal"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_surface_rounded"
            android:src="@drawable/ic_close"
            app:tint="#F4F0E6" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="New goal"
            android:textColor="#F4F0E6"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="34dp"
            android:layout_height="34dp" />
    </LinearLayout>

    <!-- Scrollable Form Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="22dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBarAddGoal"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonsGoal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Goal Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goal name"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etGoalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. New laptop"
                android:textColorHint="#5C5B60"
                android:textColor="#F4F0E6"
                android:padding="14dp"
                android:textSize="14sp"
                android:layout_marginBottom="18dp" />

            <!-- Target Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target amount"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etTargetAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="R 0.00"
                android:textColorHint="#5C5B60"
                android:textColor="#F4F0E6"
                android:padding="14dp"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:layout_marginBottom="18dp" />

            <!-- Already Saved -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already saved (optional)"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etAlreadySaved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="R 0.00"
                android:textColorHint="#5C5B60"
                android:textColor="#F4F0E6"
                android:padding="14dp"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:layout_marginBottom="18dp" />

            <!-- Target Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target date"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etTargetDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="Select date"
                android:textColorHint="#5C5B60"
                android:textColor="#F4F0E6"
                android:padding="14dp"
                android:textSize="14sp"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginBottom="18dp" />

            <!-- Icon Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Icon"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- Active Icon -->
                <androidx.cardview.widget.CardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="10dp"
                    app:cardCornerRadius="13dp"
                    app:cardBackgroundColor="#E2B13C"
                    app:cardElevation="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✈️"
                        android:textSize="18sp" />
                </androidx.cardview.widget.CardView>

                <!-- Inactive Icon 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="10dp"
                    app:cardCornerRadius="13dp"
                    app:cardBackgroundColor="#111113"
                    app:strokeColor="#232326"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="💻"
                        android:textSize="18sp" />
                </androidx.cardview.widget.CardView>

                <!-- Inactive Icon 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="10dp"
                    app:cardCornerRadius="13dp"
                    app:cardBackgroundColor="#111113"
                    app:strokeColor="#232326"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🏠"
                        android:textSize="18sp" />
                </androidx.cardview.widget.CardView>

                <!-- Inactive Icon 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardCornerRadius="13dp"
                    app:cardBackgroundColor="#111113"
                    app:strokeColor="#232326"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🎓"
                        android:textSize="18sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons Layout -->
    <LinearLayout
        android:id="@+id/bottomButtonsGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnSaveGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#F4F0E6"
            android:textColor="#0A0A0B"
            android:text="Save goal"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            app:cornerRadius="100dp"
            android:paddingVertical="14dp" />

        <Button
            android:id="@+id/btnCancelGoal"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#F4F0E6"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="100dp"
            app:strokeColor="#232326"
            android:paddingVertical="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>