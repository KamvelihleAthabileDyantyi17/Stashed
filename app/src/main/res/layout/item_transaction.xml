<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="11dp"
    android:background="#050506">

    <!-- Icon Circle -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvIconBackground"
        android:layout_width="38dp"
        android:layout_height="38dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#221111"
        app:cardElevation="0dp">

        <TextView
            android:id="@+id/tvIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🛒"
            android:textSize="18sp" />
    </androidx.cardview.widget.CardView>

    <!-- Text Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvTransactionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Woolworths"
            android:textColor="#F4F0E6"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTransactionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Groceries · Today"
            android:textColor="#8B8A8E"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Amount -->
    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-R412"
        android:textColor="#FF6B5E"
        android:textSize="13.5sp"
        android:textStyle="bold" />

</LinearLayout>