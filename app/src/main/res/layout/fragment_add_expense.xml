<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050506">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBarExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="22dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Close/Back Button -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_surface_rounded"
            android:src="@drawable/ic_close"
            app:tint="#F4F0E6" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Log an expense"
            android:textColor="#F4F0E6"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Empty view for spacing balance -->
        <View
            android:layout_width="34dp"
            android:layout_height="34dp" />
    </LinearLayout>

    <!-- Scrollable Form Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="22dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBarExpense"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonsLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Amount Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount"
                    android:textColor="#8B8A8E"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="baseline">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R"
                        android:textColor="#8B8A8E"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <EditText
                        android:id="@+id/etExpenseAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="0.00"
                        android:textColorHint="#5C5B60"
                        android:textColor="#F4F0E6"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Category Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORY"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" />

            <!-- Horizontal flow or standard layout for chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- You will reuse your bg_chip_active and inactive drawables here -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛒 Groceries"
                        android:paddingHorizontal="13dp"
                        android:paddingVertical="9dp"
                        android:background="@drawable/bg_chip_active"
                        android:textColor="#E2B13C"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <!-- Add other category chips here using bg_chip_inactive and #8B8A8E text color -->

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Input Fields -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merchant"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etMerchant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="Where'd you spend it?"
                android:textColorHint="#5C5B60"
                android:textColor="#F4F0E6"
                android:padding="14dp"
                android:textSize="14sp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note (optional)"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="Add a note"
                android:textColorHint="#5C5B60"
                android:textColor="#F4F0E6"
                android:padding="14dp"
                android:textSize="14sp"
                android:layout_marginBottom="14dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons Layout -->
    <LinearLayout
        android:id="@+id/bottomButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnSaveExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#F4F0E6"
            android:textColor="#0A0A0B"
            android:text="Save expense"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            app:cornerRadius="100dp"
            android:paddingVertical="14dp" />

        <Button
            android:id="@+id/btnCancel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#F4F0E6"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="100dp"
            app:strokeColor="#232326"
            android:paddingVertical="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>