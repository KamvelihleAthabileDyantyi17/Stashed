<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050506">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBarAddExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="22dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Close Button -->
        <ImageButton
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_surface_rounded"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#F4F0E6" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="New expense"
            android:textColor="#F4F0E6"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Camera / Scan Receipt Button -->
        <ImageButton
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_surface_rounded"
            android:src="@drawable/ic_camera_alt"
            app:tint="#F4F0E6" />
    </LinearLayout>

    <!-- Scrollable Form Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="22dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBarAddExpense"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonsExpense">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount (R)"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etExpenseAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="0.00"
                android:textColorHint="#5C5B60"
                android:textColor="#F4F0E6"
                android:padding="14dp"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:layout_marginBottom="18dp" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etExpenseDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. Checkers groceries"
                android:textColorHint="#5C5B60"
                android:textColor="#F4F0E6"
                android:padding="14dp"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:layout_marginBottom="18dp" />

            <!-- Category Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <!-- We use the same background for the spinner to match the inputs -->
            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:popupBackground="#111113"
                android:layout_marginBottom="18dp"/>

            <!-- Error Message -->
            <TextView
                android:id="@+id/tvExpenseError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Error message"
                android:textColor="#FF6B5E"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons Layout -->
    <LinearLayout
        android:id="@+id/bottomButtonsExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnSaveExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#F4F0E6"
            android:textColor="#0A0A0B"
            android:text="Save expense"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            app:cornerRadius="100dp"
            android:paddingVertical="14dp" />

        <Button
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#F4F0E6"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="100dp"
            app:strokeColor="#232326"
            android:paddingVertical="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>