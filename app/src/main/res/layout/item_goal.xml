<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#111113"
    app:cardCornerRadius="20dp"
    app:strokeColor="#232326"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Circular Progress Ring Wrapper -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="14dp">

            <!-- The progress color will be set dynamically in your Kotlin Adapter -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressGoal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progress="32"
                app:indicatorColor="#E2B13C"
                app:trackColor="#1A1A1D"
                app:trackThickness="5dp"
                app:indicatorSize="52dp" />

            <TextView
                android:id="@+id/tvGoalProgressPercentage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="32%"
                android:textColor="#F4F0E6"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Goal Text Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGoalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New laptop"
                android:textColor="#F4F0E6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGoalDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="R3,200 of R10,000 · by Dec 2026"
                android:textColor="#8B8A8E"
                android:textSize="11.5sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>